# Local environment example for development. DO NOT commit real secrets.
# Copy this file to .env or .env.local and fill in real values (add to .gitignore).

# Shared
JWT_SECRET=your_jwt_secret_here

# Auth service
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB>?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=your_auth_db_password_here

# Patient service
PATIENTDB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB>?sslmode=require
PATIENTDB_USERNAME=avnadmin
PATIENTDB_PASSWORD=your_patient_db_password_here

# Doctor service
DOCTORDB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB>?sslmode=require
DOCTORDB_USERNAME=avnadmin
DOCTORDB_PASSWORD=your_doctor_db_password_here

# Appointment service
APPOINTMENTDB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB>?sslmode=require
APPOINTMENTDB_USERNAME=avnadmin
APPOINTMENTDB_PASSWORD=your_appointment_db_password_here

# Prescription service
PRESCRIPTIONDB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB>?sslmode=require
PRESCRIPTIONDB_USERNAME=avnadmin
PRESCRIPTIONDB_PASSWORD=your_prescription_db_password_here
