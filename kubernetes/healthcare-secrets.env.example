# Example env file to create Kubernetes secret for `healthcare-secrets`.
# Copy to `kubernetes/healthcare-secrets.env`, fill in real values, and keep it local (do not commit).

JWT_SECRET=your_jwt_secret_here

# Auth service
DB_URL=jdbc:postgresql://<AUTH_HOST>:<PORT>/defaultdb?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=your_auth_db_password_here

# Patient service
PATIENTDB_URL=jdbc:postgresql://<PATIENT_HOST>:<PORT>/defaultdb?sslmode=require
PATIENTDB_USERNAME=avnadmin
PATIENTDB_PASSWORD=your_patient_db_password_here

# Doctor service
DOCTORDB_URL=jdbc:postgresql://<DOCTOR_HOST>:<PORT>/defaultdb?sslmode=require
DOCTORDB_USERNAME=avnadmin
DOCTORDB_PASSWORD=your_doctor_db_password_here

# Appointment service
APPOINTMENTDB_URL=jdbc:postgresql://<APPOINTMENT_HOST>:<PORT>/defaultdb?sslmode=require
APPOINTMENTDB_USERNAME=avnadmin
APPOINTMENTDB_PASSWORD=your_appointment_db_password_here

# Prescription service
PRESCRIPTIONDB_URL=jdbc:postgresql://<PRESCRIPTION_HOST>:<PORT>/defaultdb?sslmode=require
PRESCRIPTIONDB_USERNAME=avnadmin
PRESCRIPTIONDB_PASSWORD=your_prescription_db_password_here
